# ============================================================
# LifeOS .gitignore — Safe for public GitHub repo
# ============================================================

# Environment & Secrets
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
.env.staging

# Private/sensitive data
data/private/
src/data/
# Current and legacy flattened data paths used by ingestion and chat code
/private/
/inbox/
/knowledge/
/experts/
/business/
/career/
/tracking/
/tts_cache/
/expert_chat_state.json

# Logs & generated outputs (too large for git)
logs/
outputs/
data/tts_cache/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing artifacts
.pytest_cache/
.coverage
htmlcov/

# Streamlit secrets
.streamlit/secrets.toml

# macOS
.DS_Store
.AppleDouble
Thumbs.db

# Syncthing files
.stfolder/
.stfolder
.stignore
**/.stignore
**/.stfolder/
**/.syncthing*
**/.stversions/

# UI & State cache
data/expert_chat_state.json
data/tracking/lenny_ingest.json

# Scratch / one-off dev scripts (never commit these)
scratch/
.agents/

# SQLite indexes (rebuilt at startup)
/indexes/
/src/indexes/

# Raw transcripts (can be very large)
**/raw/

# Raw inbox — unprocessed personal input
data/inbox/raw/
data/inbox/processed/raw/
data/inbox/imports/
data/inbox/voice/

# Hermes weekly output (local only — never public)
data/inbox/proposals/
data/inbox/content_drafts/

# Personal config (profile.yml contains real personal info)
# Use profile.example.yml as the template instead
config/profile.yml
config/models.yml
config/privacy.yml
config/domains.yaml
# Local personal automation configuration
config/pregnancy_daily_content.json

# Local operational handoffs and private deployment research
/HANDOFF.md
/docs/hermes-agent-research.md
/docs/research/hermes-sydney-scheduling.md
/docs/research/telegram-delivery-repair.md

# Personal delivery automation stays with the private runtime
/scripts/pregnancy_daily.py
/scripts/pregnancy_delivery_watchdog.py
/tests/test_pregnancy_daily.py
/tests/test_pregnancy_delivery_watchdog.py
/tests/test_hermes_sydney_scheduler.py

# Exclude all markdown notes and transcripts
data/knowledge/**/*.md
data/experts/**/*.md
data/business/**/*.md
data/career/**/*.md
data/inbox/**/*.md

# Scratch tools in root
fix_*.py
format_*.py
scratch_*.py

# ============================================================
# Explicitly KEEP these (force-include reusable system files)
# ============================================================
!modes/
!templates/
!scripts/
!config/profile.example.yml
!config/models.example.yml
!config/domains.example.yaml
!config/domain_map.yaml
!/.env.example
!/README.md
!/AGENTS.md
!data/README.md
!data/knowledge/creator-profiles/README.md
!**/example-*.md
!**/.gitkeep


# LaunchAgents
*.plist
!*.example.plist

# Git mailmap (contains real author identity)
.git-mailmap

# Backup files
*.bak
